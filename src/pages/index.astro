---
// Homepage (EN). Teks dari docs/content.md; dipindah ke Keystatic di /5-cms.
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Button from "../components/Button.astro";
import Section from "../components/Section.astro";
import Card from "../components/Card.astro";
import { Image } from "astro:assets";
import hannah from "../assets/portfolio/by-hannah-cover.webp";
import luz from "../assets/portfolio/luz-dental-care-cover.webp";
import skin from "../assets/portfolio/skincosmedic-cover.webp";

const contact = {
  email: "owenprasimsha84@gmail.com",
  phone: "081227418327",
  whatsapp: "https://wa.me/6281227418327",
  location: "Indonesia, remote",
  social: [
    { label: "LinkedIn", href: "https://www.linkedin.com/in/owen-prasimsha/" },
    { label: "GitHub", href: "https://github.com/OwenPrasimsha" },
  ],
};
const meta = {
  title: "Owen Prasimsha | Web Developer",
  description: "Portfolio of Owen Prasimsha, a freelance web developer working with agencies and businesses.",
};
const nav = [
  { label: "Work", href: "#work" },
  { label: "About", href: "#about" },
  { label: "Services", href: "#services" },
  { label: "Contact", href: "#contact" },
];
const hero = {
  title: "Owen Prasimsha",
  role: "Web developer",
  subtitle: "I build clean, well-structured websites with WordPress and Elementor for agencies and businesses.",
  button: "Let's talk",
};
const projects = [
  { title: "Project One", meta: "Category / Year", text: "One sentence on what you built.", image: hannah, alt: "[ALT: by-hannah-cover]", href: "#" },
  { title: "Project Two", meta: "Category / Year", text: "[TEKS: deskripsi singkat proyek dua]", image: luz, alt: "[ALT: luz-dental-care-cover]", href: "#" },
  { title: "Project Three", meta: "Category / Year", text: "[TEKS: deskripsi singkat proyek tiga]", image: skin, alt: "[ALT: skincosmedic-cover]", href: "#" },
];
// Sementara: 3 foto diduplikasi jadi 6 sampai item portfolio bertambah
const moreWork = [...projects, ...projects];
const about = "I'm Owen, a web developer based in Indonesia. I work remotely with agencies and businesses in Indonesia and abroad, turning ideas into websites that look clear and feel easy to use.";
const skillGroups = [
  { label: "Platforms", items: ["WordPress", "Elementor", "WooCommerce", "Shopify", "Webflow", "WPML"] },
  { label: "Build", items: ["React", "Astro", "PHP", "Tailwind CSS", "SCSS"] },
  { label: "Practice", items: ["Responsive web design", "Website performance", "SEO", "Figma to WordPress handoff"] },
];
const services = [
  { title: "Websites", text: "Business sites and landing pages, designed and built to be clear, responsive, and easy for you to manage.", tags: ["UI / UX design", "Responsive development", "CMS setup", "Handover"] },
  { title: "WordPress", text: "WordPress sites built with Elementor, from new builds to rebuilds of older sites, set up so your team can update content without breaking the layout.", tags: ["Elementor", "Theme customization", "Redesign", "Maintenance"] },
  { title: "Shopify", text: "Shopify stores set up and customized to match your brand, with product pages that are easy to browse and simple for you to manage.", tags: ["Theme customization", "Store setup", "Product pages", "Apps integration"] },
  { title: "Webflow", text: "Webflow sites built from your design, with a clean structure and CMS collections your team can edit without touching the layout.", tags: ["Design to Webflow", "CMS collections", "Responsive build", "Handover"] },
  { title: "SEO & Performance", text: "Making sites faster and easier to find, with clean structure, sensible metadata, and speed improvements.", tags: ["On-page SEO", "Speed optimization", "Metadata", "Analytics setup"] },
];
const cta = { title: "Let's talk", text: "Have a project in mind? Send me a message." };
---
<Base title={meta.title} description={meta.description}>
  <Header nav={nav} />

  <main>
    <Section label={contact.location} index={1} labelAs="p">
      <h1 class="font-display text-display">{hero.title}</h1>
      <div class="mt-8 grid md:grid-cols-9 gap-6">
        <p class="md:col-span-3 font-title text-h3">{hero.role}</p>
        <p class="md:col-span-4 text-stone">{hero.subtitle}</p>
        <div class="md:col-span-2 md:justify-self-end">
          <Button href={contact.whatsapp} external>{hero.button}</Button>
        </div>
      </div>
    </Section>

    <Section id="work" label={`Selected projects — ${String(projects.length).padStart(2, "0")}`} index={2} labelId="work-label">
      <Fragment slot="aside">
        <p class="font-title text-h1 mt-6">Work</p>
        <p class="mt-4 text-stone max-w-sm">[TEKS: penjelasan singkat selected projects]</p>
      </Fragment>
      <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4 lg:gap-6">
        {projects.map((p, i) => (
          <Card {...p} index={i + 1} total={projects.length} linkLabel="View project" />
        ))}
      </div>
    </Section>

    <Section id="about" label="About" index={3} labelId="about-label">
      <p class="font-title text-h2">{about}</p>
    </Section>

    <Section label="Skill" index={4} labelId="skill-label">
      <dl>
        {skillGroups.map((g) => (
          <div class="grid md:grid-cols-9 gap-2 md:gap-4 border-b border-line py-4 first:pt-0">
            <dt class="label md:col-span-2 pt-1">{g.label}</dt>
            <dd class="md:col-span-7">{g.items.join(" / ")}</dd>
          </div>
        ))}
      </dl>
    </Section>

    <Section id="services" label="Services" index={5} labelId="services-label">
      <div class="grid sm:grid-cols-2 xl:grid-cols-3 gap-4 lg:gap-6">
        {services.map((s, i) => <Card variant="service" {...s} index={i + 1} />)}
      </div>
    </Section>

    <!-- More work: tanpa JS / reduced motion = scroll-snap native; dengan GSAP = section di-pin sampai slide terakhir -->
    <Section label="More work" index={6} labelId="more-label" data-slider>
      <div data-slider-viewport class="overflow-x-auto snap-x snap-mandatory overscroll-x-contain [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        <div data-slider-track class="flex gap-4 w-max">
          {moreWork.map((p) => (
            <figure data-slider-item class="snap-start shrink-0 w-[75vw] md:w-88">
              <Image src={p.image} alt={p.alt} class="w-full aspect-[4/5] object-cover rounded-card" />
            </figure>
          ))}
        </div>
      </div>
    </Section>

    <Section id="contact" label="Contact" index={7} labelId="contact-label">
      <p class="font-display text-display">{cta.title}</p>
      <p class="mt-6 text-stone">{cta.text}</p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href={contact.whatsapp} external>WhatsApp</Button>
        <Button href={`mailto:${contact.email}`} variant="secondary">Email</Button>
      </div>
    </Section>
  </main>

  <Footer email={contact.email} phone={contact.phone} whatsapp={contact.whatsapp} social={contact.social} backToTop="Back to top" />

  <script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    const section = document.querySelector<HTMLElement>("[data-slider]");
    const viewport = section?.querySelector<HTMLElement>("[data-slider-viewport]");
    const track = section?.querySelector<HTMLElement>("[data-slider-track]");

    if (section && viewport && track) {
      gsap.matchMedia().add("(prefers-reduced-motion: no-preference)", () => {
        viewport.style.overflow = "hidden";
        const distance = () => track.scrollWidth - viewport.clientWidth;
        gsap.to(track, {
          x: () => -distance(),
          ease: "none",
          scrollTrigger: {
            trigger: section,
            start: "center center",
            end: () => `+=${distance()}`,
            pin: true,
            scrub: true,
            invalidateOnRefresh: true,
          },
        });
        return () => { viewport.style.overflow = ""; };
      });
    }
  </script>
</Base>
